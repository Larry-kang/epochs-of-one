{
  "name": "epochs-of-one",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "description": "\u6642\u4ee3\u4eba\u751f / Epochs of One \u2014 data-driven life simulation",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "data": "node pipeline/run.mjs",
    "data:validate": "node pipeline/validate.mjs",
    "license-gate": "node pipeline/license-gate.mjs",
    "prebuild": "node pipeline/validate.mjs && node pipeline/license-gate.mjs",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "sim": "tsc -p tsconfig.node.json && node .cache/node/src/cli/sim.js",
    "calibrate": "tsc -p tsconfig.node.json && node .cache/node/src/cli/calibrate.js",
    "e2e": "playwright test",
    "calwealth": "tsc -p tsconfig.node.json && node .cache/node/src/cli/calwealth.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "20.19.43",
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
