{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Data manifest",
  "type": "object",
  "required": ["dataVersion", "generated", "sources", "files"],
  "additionalProperties": false,
  "properties": {
    "dataVersion": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$" },
    "generated": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "url", "license", "retrieved"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "name": { "type": "string" },
          "url": { "type": "string", "pattern": "^https://" },
          "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "license": {
            "type": "object",
            "required": ["id", "class", "url"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "class": { "enum": ["open", "attribution", "nc", "restricted", "unknown"] },
              "url": { "type": "string" },
              "archived": { "type": "array", "items": { "type": "string" } },
              "caveat": { "type": "string" }
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "src", "license", "retrieved", "url", "schema"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "src": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "license": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "retrieved": { "type": "string" },
          "url": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "schema": { "type": "string" },
          "rows": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
