{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "demography-country.schema.json",
  "title": "Per-country abridged period life tables (WPP 2024)",
  "type": "object",
  "required": ["iso", "from", "to", "ages", "M", "F", "e0", "q5"],
  "additionalProperties": false,
  "$defs": {
    "sexTable": {
      "type": "object",
      "required": ["qx", "mxLast", "ax0"],
      "additionalProperties": false,
      "properties": {
        "qx": { "type": "array", "items": { "type": "array", "minItems": 22, "maxItems": 22, "items": { "type": "number", "minimum": 0, "maximum": 1 } } },
        "mxLast": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 } },
        "ax0": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 } }
      }
    },
    "tri": {
      "type": "object", "required": ["T", "M", "F"], "additionalProperties": false,
      "properties": { "T": { "type": "array", "items": { "type": "number" } }, "M": { "type": "array", "items": { "type": "number" } }, "F": { "type": "array", "items": { "type": "number" } } }
    }
  },
  "properties": {
    "iso": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "from": { "type": "integer" },
    "to": { "type": "integer" },
    "ages": { "type": "array", "minItems": 22, "maxItems": 22, "items": { "type": "integer" } },
    "M": { "$ref": "#/$defs/sexTable" },
    "F": { "$ref": "#/$defs/sexTable" },
    "e0": { "$ref": "#/$defs/tri", "description": "WPP published life expectancy at birth (years)" },
    "q5": { "$ref": "#/$defs/tri", "description": "under-5 mortality probability (0..1). T from WPP Q5/1000; M/F from life table l5/l0" }
  }
}
